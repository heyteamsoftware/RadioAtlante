# /etc/systemd/system/liquidsoap-radio.service
[Unit]
Description=Radio Atlante - Liquidsoap Auto-DJ 24h
After=network.target icecast2.service
Requires=icecast2.service

[Service]
Type=simple
User=liquidsoap
Group=liquidsoap
ExecStart=/usr/bin/liquidsoap /etc/liquidsoap/radio.liq
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
